# Para desarrollo local con `npm run dev:worker` (wrangler dev).
# COPIA este archivo a `.dev.vars` y rellena tus claves.
# `.dev.vars` está en .gitignore y NUNCA debe subirse a GitHub.
TMDB_API_KEY=
# TMDB_ACCESS_TOKEN=
OMDB_API_KEY=
WATCHMODE_API_KEY=
TVDB_API_KEY=
# TVDB_PIN=
WATCH_REGION=NI
# Credenciales debrid cifradas (el Worker también necesita binding DEBRID_KV).
# DEBRID_ENCRYPTION_KEY=
# OAuth Real-Debrid: registra como callback la URL exacta de tu Worker local.
# REALDEBRID_CLIENT_ID=
# REALDEBRID_CLIENT_SECRET=
# REALDEBRID_REDIRECT_URI=http://127.0.0.1:8787/internal/debrid/real-debrid/callback
# TMDB_LANGUAGE=es
# SUPPORT_URL=https://discord.gg/J6byqsRUfu
# Donaciones vía Ko-fi (se paga con PayPal o tarjeta). "off" las oculta.
KOFI_USERNAME=hydratorrents
