# Para desarrollo local con `npm run dev:worker` (wrangler dev).
# COPIA este archivo a `.dev.vars` y rellena tus claves.
# `.dev.vars` está en .gitignore y NUNCA debe subirse a GitHub.
TMDB_API_KEY=
# TMDB_ACCESS_TOKEN=
OMDB_API_KEY=
WATCHMODE_API_KEY=
TVDB_API_KEY=
# TVDB_PIN=
# Clave gratuita de The RarBg (opcional): sube su límite de peticiones.
# RARBG_API_KEY=
WATCH_REGION=NI
# Credenciales debrid cifradas. Con esta clave ya se puede conectar: sin KV el
# Worker usa su Cache API; con `npm run debrid:kv` se añade el binding DEBRID_KV.
# DEBRID_ENCRYPTION_KEY=
# Plazo (ms) para validar la clave al conectar desde /configure (por defecto 9000).
# DEBRID_VALIDATE_TIMEOUT_MS=9000
# OAuth Real-Debrid: registra como callback la URL exacta de tu Worker local.
# REALDEBRID_CLIENT_ID=
# REALDEBRID_CLIENT_SECRET=
# REALDEBRID_REDIRECT_URI=http://127.0.0.1:8787/internal/debrid/real-debrid/callback
# TMDB_LANGUAGE=es
# SUPPORT_URL=https://discord.gg/J6byqsRUfu
# Donaciones vía Ko-fi (se paga con PayPal o tarjeta). "off" las oculta.
KOFI_USERNAME=hydratorrents
# Duplicar la cuota diaria: URL del segundo despliegue del addon (otra cuenta).
# MIRROR_ORIGINS=https://catalogos-plus-2.tu-subdominio.workers.dev
# Atajos de borde (catálogos/fichas → /catalog y /meta con 0 invocaciones).
# STATIC_SHORTCUTS=on
