# ─────────────────────────────────────────────────────────────
#  Catálogos+ · Addon de Stremio — variables de entorno
#  Copia este archivo a `.env` y rellena tus claves.
#  NUNCA subas el `.env` real a GitHub.
# ─────────────────────────────────────────────────────────────

# ── TMDB (https://www.themoviedb.org/settings/api) ───────────
# Clave v3 (la de 32 caracteres). Una de las dos es OBLIGATORIA
# para que funcionen los catálogos de películas/series.
TMDB_API_KEY=
# Token v4 "API Read Access Token" (empieza por eyJ...). Alternativa a la v3.
TMDB_ACCESS_TOKEN=

# ── OMDB (https://www.omdbapi.com/apikey.aspx) ───────────────
# Valoraciones IMDB / Rotten Tomatoes / Metacritic en la ficha.
# Opcional pero recomendado. Sin ella no se muestran ratings OMDB.
OMDB_API_KEY=

# ── TheTVDB v4 (https://thetvdb.com/api-information) ─────────
# Fichas de series/películas por IMDb id (fallback multi-fuente).
# Opcional. Con plan "user-supported" puede pedir PIN de suscriptor.
TVDB_API_KEY=
TVDB_PIN=

# ── Watchmode (https://api.watchmode.com/) ───────────────────
# "Disponible en Netflix / Prime Video..." dentro de la ficha.
# Opcional. La región se toma de WATCH_REGION.
WATCHMODE_API_KEY=

# TVMaze NO requiere clave. El catálogo "Series · En TV hoy" funciona siempre.

# ── Proveedores de contenido / streams (sin clave) ───────────
# Fuentes torrent consultadas al abrir una película/episodio:
# Knaben (knaben.org/api/v2), Torlock (Torznab), BlackHoleBay,
# Nyaa (solo anime y producciones asiáticas) y YTS (solo películas).
# Lista separada por comas; vacío/ausente = todos. El usuario
# también puede elegirlos en /configure.
STREAM_PROVIDERS=knaben,torlock,blackholebay,nyaa,yts
# Nyaa se consulta a través de una API comunitaria no oficial de nyaa.si
# (https://nyaaapi.onrender.com/docs). Cambia la URL si usas otra instancia.
# NYAA_API_URL=https://nyaaapi.onrender.com
# API de YTS (https://yts.gg/api). Cambia la URL si YTS mueve su dominio.
# YTS_API_URL=https://movies-api.accel.li/api/v2
# Máximo de streams devueltos por título (tras deduplicar por hash)
STREAM_MAX_RESULTS=30
# Timeout por indexador (1–9 s; defecto 6 s) y búsqueda alternativa (defecto 2.5 s)
STREAM_PROVIDER_TIMEOUT_MS=6000
STREAM_FALLBACK_TIMEOUT_MS=2500
# La búsqueda vive fresca 1 h y puede servirse como respaldo hasta 6 h más
STREAM_STALE_SECONDS=21600
# Servicios debrid opcionales: la clave API del usuario se introduce en /configure,
# nunca se pone en este archivo. En Cloudflare configura también el binding DEBRID_KV.
DEBRID_MAX_CHECKS=8
DEBRID_MAX_RESULTS=3
DEBRID_TIMEOUT_MS=4500
# Obligatoria para cifrar credenciales (TorBox/EasyDebrid/Premiumize y OAuth RD).
# Genera una clave aleatoria de al menos 32 caracteres; no la publiques.
DEBRID_ENCRYPTION_KEY=
# OAuth de Real-Debrid (opcional; callback debe coincidir exactamente).
REALDEBRID_CLIENT_ID=
REALDEBRID_CLIENT_SECRET=
REALDEBRID_REDIRECT_URI=

# ── Región de plataformas (JustWatch / TMDB) ─────────────────
# NI = Nicaragua · MX = México · ES = España · US = Estados Unidos · AR ...
# Es el valor de partida; cada usuario puede elegir entre 44 países en /configure.
WATCH_REGION=NI

# ── Apariencia / manifest ─────────────────────────────────────
ADDON_NAME=Catálogos+
# URL pública del addon (ej. https://mi-addon.vercel.app). Se usa para el logo.
ADDON_BASE_URL=

# ── Soporte ──────────────────────────────────────────────────
# Enlace que muestra la web (barra, tarjeta de soporte y pie). Si no se
# define, se usa la invitación permanente actual al Discord de Catálogos+.
# Si el enlace cambia, actualízalo aquí. Vale cualquier URL http(s).
# SUPPORT_URL=https://discord.gg/J6byqsRUfu

# ── Donaciones (Ko-fi) ───────────────────────────────────────
# Botón «Donar» en la barra, tarjeta propia y pie de las dos páginas. Enlaza a
# https://ko-fi.com/<usuario>, donde el donante paga con PayPal o tarjeta.
# Ko-fi no tiene API pública de lectura, así que no hace falta ninguna clave.
# Acepta el usuario («amiga»), «ko-fi.com/amiga» o la URL completa.
# KOFI_USERNAME=off oculta todas las donaciones.
KOFI_USERNAME=noe359866

# ── Afinado (opcional) ───────────────────────────────────────
# Mínimo de votos para el catálogo Top Valoradas
TMDB_MIN_VOTE_COUNT=500
# TTL de caché en segundos (por defecto 21600 = 6h)
CACHE_TTL_SECONDS=21600
# Timeout HTTP en ms
HTTP_TIMEOUT_MS=10000

# ── Local ────────────────────────────────────────────────────
PORT=7000

# Idioma por defecto de fichas/catálogos. Cada usuario puede elegir otro en
# /configure: es, es-MX, en, pt-BR, pt-PT, fr, de, it, ca, nl, pl, ru, tr,
# ar, hi, ja, ko, zh
TMDB_LANGUAGE=es
