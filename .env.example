# Credenciales TMDB: configura una de las dos para catálogos y metadatos.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
OMDB_API_KEY=
TVDB_API_KEY=
TVDB_PIN=
WATCHMODE_API_KEY=

# Fuentes de reproducción directa. Se pueden limitar desde /configure.
# Fanpelis, SpinFlix, GnulaHD, VideoApp y PelisPlus por defecto; las tres últimas son experimentales.
# Para limitar, usa una lista como fanpelis,spinflix; off = ninguna.
# STREAM_PROVIDERS=all
STREAM_MAX_RESULTS=30
STREAM_PROVIDER_TIMEOUT_MS=6000
STREAM_FALLBACK_TIMEOUT_MS=2500
STREAM_PROVIDER_COOLDOWN_SECONDS=300
STREAM_STALE_SECONDS=0

# Enlaces propios en Supabase (public.video_host_links): Mixdrop, Filemoon,
# Vihidrive y demás. Sin SUPABASE_URL y una clave, la fuente `supabase` no se
# anuncia en /configure ni en /healthz. Copia el esquema de supabase/schema.sql.
# SUPABASE_ANON_KEY respeta RLS (solo lectura); SUPABASE_SERVICE_ROLE_KEY es
# SECRETA y permite marcar enlaces roto: no la pongas en el cliente.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ENABLED=off

# País para disponibilidad de plataformas.
WATCH_REGION=NI
ADDON_NAME=RamdonLatam
ADDON_BASE_URL=
# SUPPORT_URL=https://discord.gg/J6byqsRUfu
KOFI_USERNAME=off
TMDB_MIN_VOTE_COUNT=500
CACHE_TTL_SECONDS=21600
HTTP_TIMEOUT_MS=10000
PORT=7000
TMDB_LANGUAGE=es-MX
