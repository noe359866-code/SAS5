# Catálogos/fichas pregenerados de cada configuración popular
# (public/<segmento-base64>/...). Los genera `npm run prerender --from-url` y
# se suben a Cloudflare con `wrangler deploy`; no se versionan.
public/*/manifest.json
public/*/catalog/

# Volcados de las sondas en vivo (diagnóstico). Se generan en cada ejecución
# de los workflows y no forman parte del addon. Los workflows los siguen
# subiendo a la rama con `git add -f`.
.probe/

# Android build & local signing artifacts
android/.gradle/
android/.idea/
android/local.properties
android/ci-signing/
android/out/
android/**/build/

