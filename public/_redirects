# Redirecciones servidas por el edge de Cloudflare (sin ejecutar el Worker,
# así no gastan cuota del plan free). El favicon vive en /assets/logo.png.
/favicon.ico /assets/logo.png 302

# >>> plan:static (generado por scripts/prerender-catalogs.mjs --from-url) >>>
# Rutas que el Worker respondía con una invocación (y a veces con un 404).
# _redirects se evalúa antes de los assets y del Worker: 0 invocaciones.
# Se regenera en cada despliegue; no edites dentro del bloque.
/watch /watch/ 301
/configure/ /configure 301
/manifest.json/ /manifest.json 301
/watch/index.html /watch/ 301
/configure/index.html /configure 301
/index.html / 301
# <<< plan:static <<<
